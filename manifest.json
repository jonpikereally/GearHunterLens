{
  "manifest_version": 3,
  "name": "Gear Hunter Lens",
  "version": "1.1.0",
  "description": "Hides Long & McQuade GearHunter items you've already seen, unless the price has changed.",
  "homepage_url": "https://github.com/jonpikereally/GearHunterLens",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Gear Hunter Lens",
    "default_popup": "app/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://www.long-mcquade.com/*", "https://long-mcquade.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "unlimitedStorage", "alarms"]
}
